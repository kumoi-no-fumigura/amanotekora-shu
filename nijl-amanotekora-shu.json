  },
  {
   "id": "nijl-amanotekora-shu-0002",
   "pid": "nijl-200020069",
   "pages": [
    2
   ],
   "text": "海人手古良大納言師氏卿仮名也貪信公男天慶七参儀天徳四中納言安和二大納言安和二大納言天録之薨あまのてこらは海工をとめなといはんとし。源立の秘笑へしてこ或はてこなとも万葉集におほく見たり皆女の通称と聞ゆてこらてこなあとて子なともいへることし万葉たゝ子といふへきをならとも清輔貞儀抄云家集柿本山辺氏をはしめて海手古良様師氏大納言撰豊公法一条格改集廬主増基集らにおよふすていくとはへそもし海人手吉良集白妙のゆきにかすみもみよしのゝかさねてけふや立はしむらんこちかせにこほりうすくていけのをものつりくもゝゆるをしのかもとりかくせともおそきはかへにひとりゐてなかむか宮のうくひすの丁ゑにほふかのめもはるかせにさきたへはちりやそむらんくれな竹のむめとふ人もみらぬよりきのもとなれや",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0003",
   "pid": "nijl-200020069",
   "pages": [
    3
   ],
   "text": "いまはすみれのさかりならかないとまなみよとのさしつるほともなくはるのあそひによるも然るとかみちのくのまかきのわたりいそなめてわかめかりにそあまもゆきかふ久かたのみとりのそらのくもまよりこゑもほのかにかへるかりかねわきもこかまゆくたれはあをやきのなひくにつけてまになみた哉春のすゑなつのもとにはかくれとも万つにみたれぬきしのふちなみ夏やをとめもけふやひとへになつころも神のみそきそいそきたつらむみわたせはいまはもしきもみとりにてなくみをとりのそゑのみそするこのはなのさかりになれはほとゝき寿夜ふかきねよそありあけの月あやめくさのきのかきりはひまもなみけふはよとのやあらはなるじん",
   "poems": [
    "7",
    "8",
    "9",
    "10",
    "11",
    "12",
    "13",
    "14",
    "15"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0004",
   "pid": "nijl-200020069",
   "pages": [
    4
   ],
   "text": "かすならぬしつのたまきもおのかしるいまはさるへのいそかしきかなみたれすてこのしたやみにをくら山ふもとにしかをとりすあき人あせもよにみたるゝなつもすゝしきは君にあふきのかせはやみなりたかせさにうかひもいまはをりたちて水なつかしきかものかはなみしけくあひてみたるゝをきのうはゝすらなひくはなりもみなつきぬらむ夏むすふもとあらのはきもすゑたをになり行秋もちかつきにけりかさゝきのゆきあひのはしにつきなれと秋なほわたすへき日こそとほけれこゑよはみみたるゝむしをこからしの露ふきむすふ秋のよな〳〵ひこほしのなかめにけふはあまの川さしてやわたるかさゝきのはししし露を草葉にをきて秋のよを",
   "poems": [
    "16",
    "17",
    "18",
    "19",
    "20",
    "21",
    "22",
    "23"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0005",
   "pid": "nijl-200020069",
   "pages": [
    5
   ],
   "text": "こゑもすかくにあくるまつむし山沢のいろにかひあるをみなへし古今春霞かすみていにしかり手は今そけくはる秋霧のうへ御のみやゐての石にはあるしむかすみたちたちかへりにしかりかねはけふそくりはにきつはれてなくたかさこにたちわたりたるきりまよりもみちの色のふかきそくやまやへきくのうつろひわたる庭の面にかねてもむすいよはのしらつゆほの〳〵とあまのとわたりあけたれはこきませなりやよものたまかき冬ぬきかふるころものつきにたつものはけふくらしき大桶なりけりみちのくのうたのはまへにこのはからいなからむふゆの風そからましわきはこか玉のうてなにひとりゐていとゝわさなにやまなかさらむあしたつのあそふすさきも冬くれはけさしもいゆの心ちみえくれ",
   "poems": [
    "24",
    "25",
    "26",
    "27",
    "28",
    "29",
    "30",
    "31",
    "32"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0006",
   "pid": "nijl-200020069",
   "pages": [
    6
   ],
   "text": "しも月のひよりもうちのあしろ木にいたもこほりのいほにさりけりをみかかふこゝのかさねにひかけたしとよのあかりにみゆるいもかなをしとりのふすまのなかもすゝしやとよな〳〵しもの夕かさねつゝ雲たかきよものたかねもかたちなるみなしら山にみゆるころかな宮こちとゆきかふ人のみちもなみとしのせめてもいそかしきかなもゝしきの大宮人もむれ給はゝこそとやけにをあすはかたらんあはぬゑいかてなほみてのかさまもえてしかなわかするこひのかすのしるしにあふさかのうたかた人はみちのくのさらになこそをなつくるかもしなけきつかたしき袖にくらふれはきよみかせきのなみはものかはよとゝもになへてけしきをみちのくの",
   "poems": [
    "33",
    "34",
    "35",
    "36",
    "37",
    "38",
    "39",
    "40",
    "41"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0007",
   "pid": "nijl-200020069",
   "pages": [
    7
   ],
   "text": "さはこの身よといはせてしかなすはのうみの神のみまるをなかめてけふひねもすにおりくらすかなきみこふかなみたいそてにひたちなるいろつくそこのみねはなるらきみしいなはいな〳〵こそはしなのなるあさする山となりやはてなんあつまちのはまなのはしのはやくよりふかき心はくみてしるしむかひもなきいくたのこらをあさりつゝなみたなかすにかへるつりふねおそかなになみたのたまもなかめつゝねむらてよはにあかすともし火あひての恋こゆるきにさしいてゝみれはあまのはらなみまにこゆるふねのわれかないはゝしをつくりさしけむかつらきの神にけならぬあさほらけかなひまもなくなみたに袖をぬらしつゝこまにまかせてかへるよな〳〵",
   "poems": [
    "42",
    "43",
    "44",
    "45",
    "46",
    "47",
    "48",
    "49",
    "50"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0008",
   "pid": "nijl-200020069",
   "pages": [
    8
   ],
   "text": "狭山ヲさゝの山へとよめる歟又別にしるいふ所ありやヘイかよひともつねにまとふをむさしなるさゝのやまへのしるへせよきみわりなきをしなむ書しなむみま御かやてめのさゝ山いまさゝにきみあひてあはぬなけきするかのふしゐみにこかれてかよふあまのふねかもわくらはにあふかはあふかみちのくのしのふもちすりかそふはかりをしのひねにみしのひねのかさなりてひるまなく〳〵そくちぬへし雛鷹あふさかのみちにかぎほはこえなからまたゆるこれぬした日ものせきわかれひなたかのよものわかれもかくやたつけふりはみよにすきにたるかなわかれちをけふそかきりとみちめくのいはてしのふにぬるゝ袖かないまはとてわかるゝ人をみくまのゝうらのはまゆふかさねてそおもふわかれ土となり候つかたひはたまほこの",
   "poems": [
    "51",
    "52",
    "53",
    "54",
    "55",
    "56",
    "57",
    "58"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0009",
   "pid": "nijl-200020069",
   "pages": [
    9
   ],
   "text": "みちこぬ人もなほまかふらしわかれちにゆくもとまるもふたこゝろそてにうきてもなけくころかなわかるゝを心つくしにくたるともいきのまつはら色かはらめやわかれちはちくさのとのをさしなからいなかつしやまのこまとこそみけ無常むすふ手のしつくににこる目かけの身としりぬれはちよもいな〳〵はるたてはねのひのまつをひきつれていつらいのりし千よのしるしはともし火のかけにならへしよの中をいはれひさしとかすめてし哉ちよをまつ松のみとりとみへしにははやつきくさのうつしなりけりあさかほに露のいのちをくらふれは花のにほひはひさしかりけりにはのおりにうきてたゝよふうたかたのまたきえぬまにかはるよの中",
   "poems": [
    "59",
    "60",
    "61",
    "62",
    "63",
    "64",
    "65",
    "66"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0010",
   "pid": "nijl-200020069",
   "pages": [
    10
   ],
   "text": "さはのおりにとしふるたつのちよをへてのちははねうつほともなしまや色ふかきみねのもこみちもやまかはのそこにくちはのみくつとそなる二つもなしきみとりも見へすすかはねしいはれもしろきなきさなりけりいのりさゝれいしにおひんよまつにすをつくるたつの日なきもきみはすみなむやまひこのをしへになしてみとり子もいつくかゝめのうちにかよはむおのゝえをてならしそめぬきみなれはなにをかくたすなにはくたさんみちとせになるてふもゝのもしかへりきみかたまにも久し山人ころもしてなつるいはほのつくるまてきみかよはひをしらさらめやはあしたつのちよのよはひをさしなからきみにゆつるとなつかへるかくもかきりなきよはひをのふるかくしまの",
   "poems": [
    "67",
    "68",
    "69",
    "70",
    "71",
    "72",
    "73",
    "74"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0011",
   "pid": "nijl-200020069",
   "pages": [
    11
   ],
   "text": "このたまくしけのとけしや君きみか世は猶おほはらのをしほやまなつのしすゑもたのもしきかなむかしよりかすかのふちのさるゆれはいまのつかひもかさしなりけりとし思はむとしのひ〳〵にちかいしおいまはたゝすの神そゆゝしき月たるこのうら〳〵ことにかつきつらあまはとまやにいくかへぬらんかせふけはひらひのなたのおとたかみなみのすへわくあまのつりふねときおもふことゝきみをおもふもおもふなりなほしるすかのわたりにてこそ花ませちかしこふる花しもになふるこやこからしの秋のはつかせ春の花にうくひすむつる",
   "poems": [
    "75",
    "76",
    "77",
    "78",
    "79",
    "80",
    "81"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0012",
   "pid": "nijl-200020069",
   "pages": [
    12
   ],
   "text": "うくひすのこつたひちらす御くら花こやはるの日のをそきなりけり夏ほたるみきはに火をとりす身をてらすほたるきしなはなつの夜のみきくらしと火をともすらん池水かゝみにわたるいけ水のことけきそこにかけなみそされはかゝみにみゆるなきはをたまのひかりていのなかにありわかるともきみをみきはにのほるにはいきのまつはらつたみさらめやあふさかのせきわかるとも身のうちつねにうかりけるたむけの神もみえぬなみかは秋の夜の月みつにうかふ秋の夜の月かけてかふ水のおもやあまのかはともみえわたるらん少将高光横川にもよりてかしらおろしけるに法服つかは寸とて柱大納之師氏御本高光東おく山の苔の衣にくらへ見よいはれか露のおきまさるらむ",
   "poems": [
    "82",
    "83",
    "84",
    "85",
    "86",
    "87",
    "88"
   ]
  },
  {
   "id": "nijl-amanotekora-shu-0013",
   "pid": "nijl-200020069",
   "pages": [
    13
   ],
   "text": "右一冊以定家卿自筆写之本或仮字真字不違一字或行数等如本令書両度令校合畢難然猶不審之事多之可尋証本者哉安永十辛丑春三月以江田氏本金一枚畢一天明二壬寅秋九月以江田氏本金再校畢源頼実集",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "あまのてこらは海工をとめなといはんとし。源立の秘笑へし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "てこ或はてこなとも万葉集におほく見たり皆女の通称と聞ゆてこらてこなあとて",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "白妙のゆきにかすみもみよしのゝかさねてけふや立はしむらん",
   "kana": "",
   "speaker": "納言撰",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "こちかせにこほりうすくていけのをものつりくもゝゆるをしのかもとり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "かくせともおそきはかへにひとりゐてなかむか宮のうくひすの丁ゑ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "にほふかのめもはるかせにさきたへはちりやそむらんくれな竹のむめ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "いとまなみよとのさしつるほともなくはるのあそひによるも然るとか",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "みちのくのまかきのわたりいそなめてわかめかりにそあまもゆきかふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "久かたのみとりのそらのくもまよりこゑもほのかにかへるかりかね",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "わきもこかまゆくたれはあをやきのなひくにつけてまになみた哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "春のすゑなつのもとにはかくれとも万つにみたれぬきしのふちなみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一条格改集廬主",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "やをとめもけふやひとへになつころも神のみそきそいそきたつらむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "みわたせはいまはもしきもみとりにてなくみをとりのそゑのみそする",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "このはなのさかりになれはほとゝき寿夜ふかきねよそありあけの月",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "あやめくさのきのかきりはひまもなみけふはよとのやあらはなるじん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "かすならぬしつのたまきもおのかしるいまはさるへのいそかしきかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "みたれすてこのしたやみにをくら山ふもとにしかをとりすあき人",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "あせもよにみたるゝなつもすゝしきは君にあふきのかせはやみなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "たかせさにうかひもいまはをりたちて水なつかしきかものかはなみ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "しけくあひてみたるゝをきのうはゝすらなひくはなりもみなつきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "夏むすふもとあらのはきもすゑたをになり行秋もちかつきにけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "こゑよはみみたるゝむしをこからしの露ふきむすふ秋のよな〳〵",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "ひこほしのなかめにけふはあまの川さしてやわたるかさゝきのはし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "山沢のいろにかひあるをみなへし古今春霞かすみて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "かすみたちたちかへりにしかりかねはけふそくりはにきつはれてなく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "たかさこにたちわたりたるきりまよりもみちの色のふかきそくやま",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "やへきくのうつろひわたる庭の面にかねてもむすいよはのしらつゆ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "ほの〳〵とあまのとわたりあけたれはこきませなりやよものたまかき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ぬきかふるころものつきにたつものはけふくらしき大桶なりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "みちのくのうたのはまへにこのはからいなからむふゆの風そからまし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "わきはこか玉のうてなにひとりゐていとゝわさなにやまなかさらむ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "あしたつのあそふすさきも冬くれはけさしもいゆの心ちみえくれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "しも月のひよりもうちのあしろ木にいたもこほりのいほにさりけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "をみかかふこゝのかさねにひかけたしとよのあかりにみゆるいもかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "をしとりのふすまのなかもすゝしやとよな〳〵しもの夕かさねつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "雲たかきよものたかねもかたちなるみなしら山にみゆるころかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "宮こちとゆきかふ人のみちもなみとしのせめてもいそかしきかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "もゝしきの大宮人もむれ給はゝこそとやけにをあすはかたらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "いかてなほみてのかさまもえてしかなわかするこひのかすのしるしに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "あふさかのうたかた人はみちのくのさらになこそをなつくるかもし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "なけきつかたしき袖にくらふれはきよみかせきのなみはものかは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "すはのうみの神のみまるをなかめてけふひねもすにおりくらすかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "きみこふかなみたいそてにひたちなるいろつくそこのみねはなるら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "きみしいなはいな〳〵こそはしなのなるあさする山となりやはてなん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "あつまちのはまなのはしのはやくよりふかき心はくみてしるしむ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "かひもなきいくたのこらをあさりつゝなみたなかすにかへるつりふね",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "おそかなになみたのたまもなかめつゝねむらてよはにあかすともし火",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あはぬゑ",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "こゆるきにさしいてゝみれはあまのはらなみまにこゆるふねのわれかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あひての恋",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "いはゝしをつくりさしけむかつらきの神にけならぬあさほらけかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あひての恋",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "ひまもなくなみたに袖をぬらしつゝこまにまかせてかへるよな〳〵",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あひての恋",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "かよひともつねにまとふをむさしなるさゝのやまへのしるへせよきみ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "わりなきをしなむ書しなむみま御かやてめのさゝ山いまさゝにきみ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "あひてあはぬなけきするかのふしゐみにこかれてかよふあまのふねかも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "わくらはにあふかはあふかみちのくのしのふもちすりかそふはかりを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "しのひねにみしのひねのかさなりてひるまなく〳〵そくちぬへし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "あふさかのみちにかぎほはこえなからまたゆるこれぬした日ものせき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ヘイ",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "ひなたかのよものわかれもかくやたつけふりはみよにすきにたるかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "わかれ",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "わかれちをけふそかきりとみちめくのいはてしのふにぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "わかれ",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "わかれちにゆくもとまるもふたこゝろそてにうきてもなけくころかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "わかれ",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "わかるゝを心つくしにくたるともいきのまつはら色かはらめや",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "わかれ",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "むすふ手のしつくににこる目かけの身としりぬれはちよもいな〳〵",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "はるたてはねのひのまつをひきつれていつらいのりし千よのしるしは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "ともし火のかけにならへしよの中をいはれひさしとかすめてし哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "ちよをまつ松のみとりとみへしにははやつきくさのうつしなりけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "あさかほに露のいのちをくらふれは花のにほひはひさしかりけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "にはのおりにうきてたゝよふうたかたのまたきえぬまにかはるよの中",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "さはのおりにとしふるたつのちよをへてのちははねうつほともなしまや",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "色ふかきみねのもこみちもやまかはのそこにくちはのみくつとそなる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "二つもなしきみとりも見へすすかはねしいはれもしろきなきさなりけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "無常",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "さゝれいしにおひんよまつにすをつくるたつの日なきもきみはすみなむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "やまひこのをしへになしてみとり子もいつくかゝめのうちにかよはむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "おのゝえをてならしそめぬきみなれはなにをかくたすなにはくたさん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "みちとせになるてふもゝのもしかへりきみかたまにも久し山人",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "ころもしてなつるいはほのつくるまてきみかよはひをしらさらめやは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "きみか世は猶おほはらのをしほやまなつのしすゑもたのもしきかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "むかしよりかすかのふちのさるゆれはいまのつかひもかさしなりけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "いのり",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "思はむとしのひ〳〵にちかいしおいまはたゝすの神そゆゝしき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "とし",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "たるこのうら〳〵ことにかつきつらあまはとまやにいくかへぬらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "かせふけはひらひのなたのおとたかみなみのすへわくあまのつりふね",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "おもふことゝきみをおもふもおもふなりなほしるすかのわたりにてこそ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "とき",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "ませちかしこふる花しもになふるこやこからしの秋のはつかせ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "うくひすのこつたひちらす御くら花こやはるの日のをそきなりけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "春の花にうくひすむつる"
  },
  {
   "seq": "83",
   "text": "身をてらすほたるきしなはなつの夜のみきくらしと火をともすらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "夏ほたるみきはに火をとりす"
  },
  {
   "seq": "84",
   "text": "いけ水のことけきそこにかけなみそされはかゝみにみゆるなきはを",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "池水かゝみにわたる"
  },
  {
   "seq": "85",
   "text": "わかるともきみをみきはにのほるにはいきのまつはらつたみさらめや",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "たまのひかりていのなかにあり"
  },
  {
   "seq": "86",
   "text": "わかるとも身のうちつねにうかりけるたむけの神もみえぬなみかは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あふさかのせき",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "秋の夜の月かけてかふ水のおもやあまのかはともみえわたるらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "秋の夜の月みつにうかふ"
  },
  {
   "seq": "88",
   "text": "おく山の苔の衣にくらへ見よいはれか露のおきまさるらむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020069",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "少将高光横川にもよりてかしらおろしけるに法服つかは寸とて柱大納之師氏"
  }
 ],
